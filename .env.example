# Copy this file to .env in the repository root. Never commit real keys.
# Required for browser recording and automatic idea processing.
GRADIUM_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Audio speaker matching uses the same Gemini key as idea enrichment.
SPEAKER_MODEL=gemini-3.8-flash

# Storm uses the existing Gemini key to watch discussion focus during recording.
STORM_ENABLED=true
# Opt-in testing: interrupt after about 60 seconds, then cool down for 2 minutes.
STORM_TEST_MODE=false
# Blank uses GEMINI_FAST_MODEL, then GEMINI_MODEL. Voice uses browser speech output.
STORM_MODEL=

# Local transcriber and Vite proxy share this port (Docker uses port 8000 internally).
TRANSCRIBER_PORT=8010
# Optional proxy override, for example http://127.0.0.1:8010.
TRANSCRIBER_TARGET=

# Optional settings for the Python enrichment service.
DEFAULT_PROVIDER=auto

# The classifier requires Gemini. Enrichment's `auto` prefers Gemini, then OpenAI.
GEMINI_FAST_MODEL=gemini-flash-lite-latest
GROUNDED_SEARCH_TIMEOUT_SECONDS=20
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=120

# Background SVG thumbnails use the title and the existing model credentials.
THUMBNAILS_ENABLED=true
# Optional text model override; blank inherits GEMINI_MODEL (OpenAI uses OPENAI_MODEL).
THUMBNAIL_MODEL=
THUMBNAIL_TIMEOUT_SECONDS=60

ENRICHMENT_HOST=0.0.0.0
ENRICHMENT_PORT=8001
