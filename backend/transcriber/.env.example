# Reference only: put these values in the repository root .env, shared by all services.
# Gradium API Key - Get yours from https://gradium.ai / https://docs.gradium.ai
GRADIUM_API_KEY=your-gradium-api-key-here

# Matches introduced names to voices.
GEMINI_API_KEY=
SPEAKER_MODEL=gemini-3.8-flash
TRANSCRIBER_PORT=8010
